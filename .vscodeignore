# Repo / CI / dev-only
.git/**
.github/**
.vscode/**
.vscode-test/**
docs/**
coverage/**
README-assets/**
AGENTS.md

# Source / test source
src/**
out-test/**

# Build/test configs not needed at runtime
esbuild.mjs
webpack.config.js
eslint.config.cjs
tsconfig.json
tsconfig.test.json
tsconfig.webview.json

# Local env / metadata
.gitignore
.nvmrc

# Japanese-version docs (kept in the repo, not shipped in the VSIX)
**/*_ja.md

# Artifacts not required in VSIX runtime
out/**
**/*.ts
**/*.map

# If packaging with --no-dependencies, keep node_modules out of VSIX
node_modules/**